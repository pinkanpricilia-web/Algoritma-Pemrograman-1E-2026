<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="HP"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-30 08:25:24 AM"/>
        <attribute name="created" value="SFA7QUNJTlRZQTsyMDI2LTA5LTI4OzA2OjE4OjU0IFBNOzE5NzA="/>
        <attribute name="edited" value="SFA7QUNJTlRZQTsyMDI2LTA5LTI4OzA2OjM0OjM4IFBNOzE7MjA3OA=="/>
        <attribute name="edited" value="cGlua2E7UElOS1BJTks7MjAyNi0wOS0zMDswODoyNToyNCBBTTs3OzI1Mjk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="diskon, setelahdiskon, pajak, totalbayar, kembalian" type="Integer" array="False" size=""/>
            <declare name="buku, pulpen, flashdisk, total, uang" type="Integer" array="False" size=""/>
            <assign variable="buku" expression="3 * 25000"/>
            <assign variable="pulpen" expression="2 * 8000"/>
            <assign variable="flashdisk" expression="75000"/>
            <assign variable="total" expression="buku + pulpen + flashdisk"/>
            <assign variable="diskon" expression="total * 10 / 100"/>
            <assign variable="setelahdiskon" expression="total - diskon"/>
            <assign variable="pajak" expression="setelahdiskon * 11 / 100"/>
            <assign variable="totalbayar" expression="setelahdiskon + pajak"/>
            <assign variable="uang" expression="200000"/>
            <assign variable="kembalian" expression="uang - totalbayar"/>
            <output expression="&quot; Total harga buku = &quot; &amp; buku" newline="True"/>
            <output expression="&quot;Total harga pulpen = &quot; &amp; pulpen" newline="True"/>
            <output expression="&quot;Total harga flashdisk = &quot; &amp; flashdisk" newline="True"/>
            <output expression="&quot;Total sebelum diskon = &quot; &amp; total" newline="True"/>
            <output expression="&quot;Diskon 10% = &quot; &amp; diskon" newline="True"/>
            <output expression="&quot;Harga setelah diskon = &quot; &amp; setelahdiskon" newline="True"/>
            <output expression="&quot;Pajak 11% = &quot; &amp; pajak" newline="True"/>
            <output expression="&quot;Total pembayaran = &quot; &amp; totalbayar" newline="True"/>
            <output expression="&quot;Uang kembalian = &quot; &amp; kembalian" newline="True"/>
        </body>
    </function>
</flowgorithm>
